{
  "version": 2,
  "builds": [
    { "src": "main.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/main.py" },
    { "src": "/studio.html", "dest": "/frontend/studio.html" },
    { "src": "/login.html", "dest": "/frontend/login.html" },
    { "src": "/signup.html", "dest": "/frontend/signup.html" },
    { "src": "/dashboard.html", "dest": "/frontend/dashboard.html" },
    { "src": "/404.html", "dest": "/frontend/404.html" },
    { "src": "/firebase-config.js", "dest": "/frontend/firebase-config.js" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
